{
  "name": "n-carousel-react",
  "version": "0.0.0",
  "private": true,
  "description": "React wrapper for n-carousel (single source of truth: reuses n-carousel JS+SCSS).",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "n-carousel": "^1.2.22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "default": "./src/styles.ts"
    }
  }
}


